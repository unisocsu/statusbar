<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1E1E1E">

    <!-- כותרת ראשי -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ הגדרות מקשים ומערכת"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- מתג 1: וילון הסטטוס באר -->
    <CheckBox
        android:id="@+id/chk_wilon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📜 וילון סטטוס באר (לחיצה ארוכה Menu)"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@android:drawable/btn_default"
        android:layout_marginBottom="10dp" />

    <!-- מתג 2: אפליקציות אחרונות -->
    <CheckBox
        android:id="@+id/chk_recents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 אפליקציות אחרונות (לחיצה ארוכה #)"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@android:drawable/btn_default"
        android:layout_marginBottom="10dp" />

    <!-- מתג 3: עכבר וירטואלי -->
    <CheckBox
        android:id="@+id/chk_mouse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖱️ עכבר וירטואלי (לחיצה ארוכה 5)"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@android:drawable/btn_default"
        android:layout_marginBottom="25dp" />

    <!-- כפתור מעבר לניהול אפליקציות -->
    <Button
        android:id="@+id/btn_open_app_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📲 ניהול הסתרת סטטוס בר לפי אפליקציה ➔"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@android:drawable/btn_default" />

</LinearLayout>
